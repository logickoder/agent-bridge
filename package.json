{
  "name": "@logickoder/agent-bridge",
  "version": "0.1.0",
  "description": "Live messaging between agent CLI sessions (Claude Code, Antigravity, opencode). Each message wakes the receiving session in place.",
  "author": {
    "name": "Jeffery Orazulike",
    "email": "jeffery@logickoder.dev",
    "url": "https://logickoder.dev"
  },
  "type": "module",
  "bin": {
    "agent-bridge": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:e2e": "pnpm build && vitest run --dir test",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "prepack": "pnpm check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logickoder/agent-bridge.git"
  },
  "files": [
    "dist",
    "src/adapters/agy/skill",
    "src/adapters/claude/plugin",
    ".claude-plugin",
    "docs/assets/logo.svg",
    "docs/assets/how-it-works.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
    "antigravity",
    "agy",
    "opencode",
    "ai-agents",
    "agent-to-agent",
    "cli"
  ],
  "homepage": "https://github.com/logickoder/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/logickoder/agent-bridge/issues"
  }
}
